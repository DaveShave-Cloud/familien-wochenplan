{
  "name": "moneytalk-film",
  "private": true,
  "version": "0.1.0",
  "description": "MoneyTalk – Notfallordner für Unternehmer. Film 1 „Plötzlich steht alles still“ und Film 2 „Gut, dass wir vorbereitet sind“ (Remotion)",
  "scripts": {
    "studio": "node scripts/generate-audio.mjs --if-missing && remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "check": "tsx scripts/check-timing.ts",
    "docs": "tsx scripts/make-docs.ts",
    "typecheck": "tsc --noEmit",
    "render": "bash scripts/render.sh film1",
    "render:clean": "bash scripts/render.sh film1-clean",
    "render:film2": "bash scripts/render.sh film2",
    "render:film2:clean": "bash scripts/render.sh film2-clean",
    "render:test": "bash scripts/render.sh test",
    "stills": "bash scripts/stills.sh",
    "prompts": "tsx scripts/make-prompts.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/cli": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
